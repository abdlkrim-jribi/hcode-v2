# ─────────────────────────────────────────────────────────────────────────────
# HCode v2 — Docker stack configuration
#
#   cp .env.docker.example .env      # .env is gitignored — never commit it
#   docker compose up --build
#   → http://localhost:8080
#
# Two modes, switched by editing the two lines in the MODE block below:
#   MOCK (default): no API key. Backend daemon emits deterministic events; the
#                   browser drives the real two-container WS path to it.
#   LIVE:           set HCODE_MOCK=0 and fill the HCODE_MODEL_* block.
# ─────────────────────────────────────────────────────────────────────────────

# ── MODE ─────────────────────────────────────────────────────────────────────
# Backend daemon mock toggle:
#   1 → keyless, deterministic mock events (demo / CI, no model calls)
#   0 → real model (requires the HCODE_MODEL_* block below)
HCODE_MOCK=1

# ── Model — LIVE only (ignored while HCODE_MOCK=1) ───────────────────────────
# Resolution mirrors the app: HCODE_MODEL_NAME → HCODE_MODEL → gpt-4o-mini, etc.
HCODE_MODEL_NAME=gpt-4o-mini
HCODE_MODEL_API_KEY=        # paste your gpt-oss / OpenAI-compatible key here for LIVE
HCODE_MODEL_BASE_URL=       # self-hosted endpoint base URL, or leave blank for default
HCODE_TOOLCALL_MODE=native  # native | json | auto  (run scripts/probe_model.py to choose)

# ── Frontend → backend WebSocket URL ─────────────────────────────────────────
# CRITICAL: this is dialed by the USER'S BROWSER on the HOST, not by the frontend
# container. It must use the HOST-mapped backend port, NOT the docker service
# name:
#     ws://localhost:8765   ✅  the host browser can reach this
#     ws://backend:8765     ❌  only resolves inside the compose network
HCODE_WS_URL=ws://localhost:8765

# ── Optional: fully-offline frontend ─────────────────────────────────────────
# VITE_MOCK=true makes the browser use built-in mock fixtures and NOT contact the
# backend at all (the WS path is not exercised). Leave blank to use the real
# two-container path above. For the standard mock demo, keep this blank and rely
# on HCODE_MOCK=1.
VITE_MOCK=
