# Loaded ONLY by the Tauri installer build (`vite build --mode tauri`, via the
# build:tauri script). Overrides .env (VITE_MOCK=false) for that build only.
#
# The packaged desktop app is a SELF-CONTAINED MOCK demo: no Python daemon is
# reachable from the installed Program Files location, so agent events come from
# the frontend mock fixtures (the enriched plan -> diff -> lsp -> verify story).
# Real filesystem actions (Open Folder, file tree, open file) still hit the real
# Tauri commands via the isTauri bypass — only agent events are mocked.
#
# Docker/web builds run `vite build` (mode production) and never load this file,
# so their runtime window.HCODE_WS_URL / HCODE_MOCK path is unaffected.
VITE_MOCK=true
