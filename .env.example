# HCode v2 environment — copy to .env and fill in. NEVER commit .env (it is git-ignored).

# ── Model (OpenAI-compatible endpoint, incl. self-hosted gpt-oss) ─────────────
# Canonical variables. These take precedence over the OPENAI_* fallbacks below.
HCODE_MODEL_NAME=gpt-oss-120b
HCODE_MODEL_BASE_URL=https://your-endpoint.example.com/v1
HCODE_MODEL_API_KEY=replace-me

# Optional: cap output tokens per call (default 2000).
# HCODE_MAX_TOKENS=2000

# ── Fallback model vars (already in active use; still honoured) ───────────────
# If the HCODE_MODEL_* vars above are unset, these are used instead:
#   OPENAI_API_KEY   -> HCODE_MODEL_API_KEY
#   OPENAI_BASE_URL  -> HCODE_MODEL_BASE_URL
#   HCODE_MODEL      -> HCODE_MODEL_NAME
# OPENAI_API_KEY=replace-me
# OPENAI_BASE_URL=https://api.openai.com/v1
# HCODE_MODEL=gpt-4o-mini

# ── Tool-calling mode ─────────────────────────────────────────────────────────
# How to bind tools to the model. Run `uv run python scripts/probe_model.py`
# against the endpoint to discover which value to use here.
#
#   native  Standard OpenAI function-calling API. Use this when the endpoint
#           supports it (probe emits a tool_call). Default.
#   json    Inject a plain-text JSON instruction + parse text responses.
#           Use this when the probe shows no native tool_call support.
#   auto    Inject instruction; prefer native tool_calls if present, else parse.
#           Good starting point when endpoint behaviour is unknown.
#
HCODE_TOOLCALL_MODE=native

# ── 429 model fallback (OFF by default — opt-in resilience) ───────────────────
# When the active model is rate-limited (HTTP 429) or hits a transient 5xx, retry
# with exponential backoff, then fall back to the next free tool-capable model so
# a 429 is a hiccup, not a hard failure. The user's chosen model is always the
# primary; fallbacks only follow on its failure. Leaving BOTH unset = OFF =
# exactly the prior single-model behaviour (no retry wrapper, no added latency).
#
# Pick ONE way to enable:
#   HCODE_FALLBACK_MODELS=qwen/qwen-2.5-coder-32b:free,deepseek/deepseek-chat:free
#       Explicit ordered fallbacks (tried after the primary, in order).
#   HCODE_MODEL_FALLBACK=auto
#       Derive fallbacks automatically from the live free + tool-capable list
#       (list_models), excluding the primary, capped to 3.
# HCODE_FALLBACK_MODELS=
# HCODE_MODEL_FALLBACK=off
#
# Retry tuning (used only when fallback is enabled):
#   HCODE_MODEL_MAX_RETRIES   retries per model before falling back (default 2)
#   HCODE_MODEL_BACKOFF_BASE  backoff seconds, doubled each retry (default 0.5)
# HCODE_MODEL_MAX_RETRIES=2
# HCODE_MODEL_BACKOFF_BASE=0.5

# ── Anthropic (alternative provider) ──────────────────────────────────────────
# Used when set AND no OpenAI-compatible key is resolved above.
# ANTHROPIC_API_KEY=replace-me

# ── LangSmith tracing (OFF by default — leave disabled unless debugging) ──────
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=replace-me
# LANGSMITH_PROJECT=hcode-v2
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
