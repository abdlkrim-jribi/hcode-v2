# HCode v2 environment — copy to .env and fill in. NEVER commit .env (it is git-ignored).

# ── Model (OpenAI-compatible endpoint, incl. self-hosted gpt-oss) ─────────────
# Canonical variables. These take precedence over the OPENAI_* fallbacks below.
HCODE_MODEL_NAME=gpt-oss-120b
HCODE_MODEL_BASE_URL=https://your-endpoint.example.com/v1
HCODE_MODEL_API_KEY=replace-me

# Optional: cap output tokens per call (default 2000).
# HCODE_MAX_TOKENS=2000

# ── Fallback model vars (already in active use; still honoured) ───────────────
# If the HCODE_MODEL_* vars above are unset, these are used instead:
#   OPENAI_API_KEY   -> HCODE_MODEL_API_KEY
#   OPENAI_BASE_URL  -> HCODE_MODEL_BASE_URL
#   HCODE_MODEL      -> HCODE_MODEL_NAME
# OPENAI_API_KEY=replace-me
# OPENAI_BASE_URL=https://api.openai.com/v1
# HCODE_MODEL=gpt-4o-mini

# ── Anthropic (alternative provider) ──────────────────────────────────────────
# Used when set AND no OpenAI-compatible key is resolved above.
# ANTHROPIC_API_KEY=replace-me

# ── LangSmith tracing (OFF by default — leave disabled unless debugging) ──────
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=replace-me
# LANGSMITH_PROJECT=hcode-v2
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
